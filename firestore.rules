rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Menu items collection: anyone can read, authenticated or applet writes
    match /menu_items/{itemId} {
      allow read, write: if true;
    }

    // Orders collection: live tracking, customer placement, staff & rider updates
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Customer reviews collection: verified ratings & comments
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Registered customers & logins collection
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Fallback for app configurations
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
